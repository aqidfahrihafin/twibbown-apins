Options -Indexes
DirectoryIndex index.php

RewriteEngine On
# Arahkan URL file lama ke URL publik yang bersih.
RewriteCond %{THE_REQUEST} \s/+twibbown/home\.php[\s?] [NC]
RewriteRule ^home\.php$ ./ [R=302,L]
RewriteCond %{THE_REQUEST} \s/+twibbown/(login|register|dashboard|admin|users|privacy|profile|logout)\.php[\s?] [NC]
RewriteRule ^(login|register|dashboard|admin|users|privacy|profile|logout)\.php$ $1 [R=302,L]
RewriteCond %{THE_REQUEST} \s/+twibbown/create\.php\?s=([a-zA-Z0-9-]+)(?:\s|&) [NC]
RewriteRule ^create\.php$ t/%1? [R=301,L,NE]

# Pertahankan akses ke aset dan gambar asli.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Semua URL aplikasi masuk melalui front controller.
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
